{
  "name": "roster-app-cloudflare-deployment",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "wrangler": "^4.107.0"
  },
  "scripts": {
    "worker:status": "wrangler deployments status --name turtlecoc",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:check": "wrangler deploy --config wrangler.jsonc --dry-run --strict --keep-vars",
    "worker:stage": "wrangler versions upload --config wrangler.jsonc --strict --keep-vars",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc --strict --keep-vars"
  }
}
