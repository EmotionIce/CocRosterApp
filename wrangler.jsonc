{
    "$schema":  "./node_modules/wrangler/config-schema.json",
    "name":  "turtlecoc",
    "account_id":  "32d4691b80f857348fba1d5fca64ecf6",
    "main":  "./cloudflarePages/_worker.js",
    "compatibility_date":  "2026-07-04",
    "workers_dev":  true,
    "preview_urls":  false,
    "keep_vars":  true,
    "assets":  {
                   "directory":  "./cloudflarePages",
                   "binding":  "ASSETS",
                   "html_handling":  "none",
                   "run_worker_first":  true
               },
    "kv_namespaces":  [
                          {
                              "binding":  "ROSTER_DATA_KV",
                              "id":  "bcbcdad929d64833a79129afc2ee7caf"
                          }
                      ],
    "logpush":  false
}
